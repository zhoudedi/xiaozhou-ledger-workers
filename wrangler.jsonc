/**
 * Wrangler configuration for XiaoZhou Ledger
 * 部署前请先在 Cloudflare 创建 D1 数据库，并替换下方 database_id
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiaozhou-ledger-workers",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-24",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "!/api/docs/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiaozhou-ledger",
      "database_id": "32efc404-327e-474a-8351-23e90f08c5ac"
    }
  ]
}